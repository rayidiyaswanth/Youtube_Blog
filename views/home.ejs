<!DOCTYPE html>
<html>
  <head>
    <%- include ('./partials/head') %>
    <title>Home - Blogify</title>
    <style>
      body {
        background-color: #f8f9fa;
      }
      .card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        overflow: hidden;
      }
      .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
      }
      .card-img-top {
        height: 200px;
        object-fit: cover;
      }
      .card-body {
        padding: 1.25rem;
      }
      .card-title a {
        color: #212529;
        text-decoration: none;
        font-weight: 600;
      }
      .card-title a:hover {
        color: #6c5ce7;
      }
      .card-text {
        color: #6c757d;
        font-size: 0.9rem;
        line-height: 1.6;
      }
      .rounded-circle {
        border: 2px solid #e9ecef;
      }
    </style>
  </head>
  <body>
    <%- include ('./partials/nav') %>
    <div class="container my-4">
      <div class="row">
        <% blogs.forEach((blog, index) => { %>
        <div class="col-md-4 mb-4">
          <div class="card h-100">
            <img src="<%= blog.coverImageUrl %>" class="card-img-top" alt="Blog Cover">
            <div class="card-body">
              <div class="d-flex align-items-center mb-3">
                <img src="<%= blog.author.profileImageUrl %>" class="rounded-circle me-2" alt="Author" style="width: 30px; height: 30px; object-fit: cover;">
                <span><%= blog.author.fullname %></span>
              </div>
              <h5 class="card-title"><a href="/blogs/<%= blog._id %>"><%= blog.title %></a></h5>
              <p class="card-text"><%= blog.body.substring(0, 100) %>...</p>
            </div>
          </div>
        </div>
        <% }) %>
      </div>
    </div>
    <%- include ('./partials/scripts') %>
  </body>
</html>
