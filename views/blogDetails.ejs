<!DOCTYPE html>
<html>
  <head>
    <%- include ('./partials/head') %>
    <title><%= blog.title %> - Blogify</title>
    <style>
      .blog-container {
        max-width: 800px;
        margin: 0 auto;
        padding: 2rem;
      }
      .blog-header {
        text-align: center;
        margin-bottom: 2rem;
      }
      .blog-title {
        font-size: 2.5rem;
        font-weight: 700;
        color: #212529;
        margin-bottom: 1rem;
      }
      .blog-cover {
        width: 100%;
        max-height: 450px;
        object-fit: cover;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        margin-bottom: 2rem;
      }
      .blog-content {
        font-size: 1.1rem;
        line-height: 1.8;
        color: #495057;
        text-align: justify;
      }
      .blog-author {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid #dee2e6;
        color: #6c757d;
        font-style: italic;
      }
      .blog-author svg {
        width: 20px;
        height: 20px;
      }
    </style>
  </head>
  <body>
    <%- include ('./partials/nav') %>
    <div class="blog-container">
      <article>
        <header class="blog-header">
          <h1 class="blog-title"><%= blog.title %></h1>
        </header>
        <img class="blog-cover" src="<%= blog.coverImageUrl %>" alt="Cover Image">
        <div class="blog-content">
          <p><%= blog.body %></p>
        </div>
        <div class="blog-author">
          <img src="<%= blog.author.profileImageUrl %>" alt="<%= blog.author.fullname %>" style="width: 40px; height: 40px; border-radius: 50%; object-fit: cover;">
          <span>By: <%= blog.author.fullname %></span>
        </div>
      </article>
    </div>
    <div class="blog-container">
      <h3>Comments(<%= comments.length %>)</h3>
      <% if (locals.user) { %>
       <form action="/blogs/comment/<%= blog._id %>" method="POST">
        <textarea name="content" placeholder="Write your comment here..." class="form-control mb-2" id="body"></textarea>
        <button type="submit" class="btn btn-primary">Add</button>
       </form>
      <% } %>
      <div class="mt-4">
        <% comments.forEach(comment => { %>
          <div class="mb-3">
            <img src="<%= comment.author.profileImageUrl %>" alt="<%= comment.author.fullname %>" style="width: 40px; height: 40px; border-radius: 50%; object-fit: cover;">
            <b><%= comment.author.fullname %></b>: <span><%= comment.content %></span>
          </div>
        <% }) %>
      </div>
    </div>
      
    <%- include ('./partials/scripts') %>
  </body>
</html>
